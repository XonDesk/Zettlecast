# Zettlecast configuration (copy to .env). Every value below is optional
# and shows its default. Full list: src/zettlecast/config.py

# --- API ---
# API_TOKEN=random-secret
# API_PORT=8000
# API_HOST=127.0.0.1

# --- Storage ---
# STORAGE_PATH=D:/path/to/_BRAIN_STORAGE
# LANCEDB_PATH=D:/path/to/_BRAIN_STORAGE/.lancedb

# --- Podcast transcription (NeMo on CUDA) ---
# NEMO_PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v2      # -v3 for 25 European languages
# NEMO_DIARIZATION_MODEL=nvidia/Nemotron-3-Diarization  # up to 8 speakers
# NEMO_CHUNK_DURATION_MINUTES=60                        # ~14 GB VRAM per hour of audio
# PODCAST_MAX_RETRIES=3

# --- LLM (Ollama) ---
# OLLAMA_MODEL=qwen3.6:35b-a3b     # summaries, cleanup, tagging
# VISION_MODEL=qwen3.6:35b-a3b     # image description + OCR
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_NUM_CTX=32768
# ENABLE_AUTO_TAGGING=true
# MODEL_IDLE_MINUTES=5             # API unloads the search models after this long unused (0 = keep loaded)
# NAME_LOOKUP=true                 # podcast names nothing local confirms are looked up on Wikipedia (online)

# --- Search ---
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B   # changing it requires: zettlecast reindex
# EMBEDDING_DIMENSIONS=1024
# RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=150
# RERANK=                    # rerank search hits with RERANKER_MODEL (default: on, off on ROLE=primary)

# --- Knowledge graph ---
# GRAPH_ALPHA=0.7               # weight of semantic similarity
# GRAPH_BETA=0.3                # weight of shared tags
# GRAPH_EDGE_THRESHOLD=0.30
# GRAPH_MAX_EDGES_PER_NOTE=6

# Only needed for gated Hugging Face models
HF_TOKEN=

# --- Two machines (deploy/macos, deploy/windows) ---
# ROLE=standalone                  # standalone | primary (always on: API, UI, database) | worker (GPU PC)
# WORKER_TOKEN=random-secret        # the same on both machines
# Primary:
# WORKER_URL=http://192.168.1.30:8010     # the worker's file server (audio, screenshot triage)
# DESKTOP_MAC_ADDRESS=aa:bb:cc:dd:ee:ff   # Wake-on-LAN (setup-worker.ps1 prints it)
# WAKE_BROADCAST=192.168.1.255
# WAKE_MIN_JOBS=1                  # wake for queued jobs once this many wait (the Wake button: any time)
# WAKE_WINDOW=                     # "01:00-07:00": wake for queued jobs only then (empty = any time)
# WORKER_LEASE_MINUTES=10          # a claimed job goes back to pending this long after the worker's last heartbeat
# Worker:
# PRIMARY_URL=http://192.168.1.20:8000
# WORKER_PORT=8010
# WORKER_IDLE_SHUTDOWN_MINUTES=15  # shut the PC down after this long idle with nobody signed in (0 = never)
